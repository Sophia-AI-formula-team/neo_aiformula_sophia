+        JObject CapturePoseSnapshot()
+        {
+            var result = new JObject { ["sim_time"] = Time.timeAsDouble,
+                ["repository_projection"] = feed.useRepositoryIntrinsics, ["camera"] = CameraCalibration() };
+            // Capture() renders from this Transform, including interpolation.
+            // Always retain its actual pose; it is not a Rigidbody odometry sample.
+            var rp = feed.transform.position; var rq = feed.transform.rotation;
+            result["render_root_position_unity"] = new JArray((double)rp.x, (double)rp.y, (double)rp.z);
+            result["render_root_quaternion_xyzw"] = new JArray((double)rq.x, (double)rq.y, (double)rq.z, (double)rq.w);
+            var drive = GetComponent<AIFormulaDifferentialDrive>();
+            var body = drive ? drive.Body : null;
+            if (!body) { result["body_available"] = false; return result; }
+            var p = body.position; var q = body.rotation; var e = q.eulerAngles;
+            result["body_available"] = true;
+            // Raw Body values are audit-only; never substitute them for image pose.
+            result["body_position_unity"] = new JArray((double)p.x, (double)p.y, (double)p.z);
+            result["body_quaternion_xyzw"] = new JArray((double)q.x, (double)q.y, (double)q.z, (double)q.w);
+            result["body_euler_unity_deg"] = new JArray((double)e.x, (double)e.y, (double)e.z);
+            return result;
+        }
+        static bool StableImageSnapshot(JObject before, JObject after)
+        {
+            if (before == null || after == null) return false;
+            foreach (string key in new[] { "sim_time", "repository_projection", "camera",
+                "render_root_position_unity", "render_root_quaternion_xyzw" })
+                if (!JToken.DeepEquals(before[key], after[key])) return false;
+            return true;
+        }
+        static bool BodyCoincidesWithImage(JObject snapshot)
+        {
+            return snapshot != null && (bool?)snapshot["body_available"] == true
+                && JToken.DeepEquals(snapshot["body_position_unity"], snapshot["render_root_position_unity"])
+                && JToken.DeepEquals(snapshot["body_quaternion_xyzw"], snapshot["render_root_quaternion_xyzw"]);
+        }
+        JObject CaptureMetadata(JObject before, JObject after)
+        {
+            string reason = "image_pose_stable";
+            if (!StableImageSnapshot(before, after)) reason = "image_pose_time_or_calibration_changed_during_capture";
+            else if ((bool?)before["repository_projection"] != true) reason = "repository_projection_disabled";
+            JObject imagePose = null;
+            if (reason == "image_pose_stable") {
+                var p = (JArray)before["render_root_position_unity"]; var q = (JArray)before["render_root_quaternion_xyzw"];
+                var forward = new Quaternion((float)q[0], (float)q[1], (float)q[2], (float)q[3]) * Vector3.forward;
+                if ((double)forward.x * forward.x + (double)forward.z * forward.z <= 1e-12)
+                    reason = "image_heading_unavailable";
+                else imagePose = new JObject {
+                    ["source"] = "unity_render_root", ["coordinate_frame"] = "unity_world",
+                    ["position_unity"] = p.DeepClone(), ["quaternion_xyzw"] = q.DeepClone(),
+                    ["planar"] = new JObject { ["frame"] = "render_root_in_odom_axes",
+                        ["x"] = (double)p[2], ["y"] = -(double)p[0], ["yaw"] = -Math.Atan2(forward.x, forward.z) }
+                };
+            }
+            bool valid = reason == "image_pose_stable";
+            string digest;
+            using (var hash = SHA256.Create())
+                digest = BitConverter.ToString(hash.ComputeHash(pendingPng)).Replace("-", "").ToLowerInvariant();
+            return new JObject {
+                ["schema"] = "aiformula_junction_capture/v2", ["valid"] = valid, ["reason"] = reason,
+                ["sequence"] = pendingSequence, ["epoch"] = LaneEpoch,
+                ["clock_kind"] = "unity_time_as_double", ["capture_time"] = valid ? before["sim_time"].DeepClone() : JValue.CreateNull(),
+                ["capture_realtime_sec"] = pendingAt, ["rgb_sha256"] = digest,
+                ["camera"] = before["camera"].DeepClone(), ["image_pose"] = imagePose,
+                ["body_image_coincident"] = BodyCoincidesWithImage(before) && BodyCoincidesWithImage(after),
+                ["before"] = before, ["after"] = after
+            };
