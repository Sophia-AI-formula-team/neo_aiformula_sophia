+def await_status(bag, state):
+    finish = time.monotonic() + 5.
+    while time.monotonic() < finish:
+        s = bag.status()
+        if s.state == state:
+            return s
+        if s.state == 'error' and state != 'error':
+            pytest.fail(s.error)
+        time.sleep(.015)
+    pytest.fail('Timed out waiting for %s: %r' % (state, bag.status()))
