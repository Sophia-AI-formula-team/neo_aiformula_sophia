-MAX_SEEDS = 64
-MAX_ITERATIONS = 60
-MAX_SECONDS = 12.0
-VERSION = "geometric_seam_v3"
-MIN_BRANCH_ANGLE_DEG = 80.0
-MAX_BRANCH_ANGLE_DEG = 95.0
-BRANCH_ANGLE_EXEMPT_EDGES = frozenset({("10000000001", "10000000005")})
