+    assert QtGui.QImage(str(path)).width() >= 800
+
+    updates = LapMapUpdates.__new__(LapMapUpdates)
+    updates.panel = panel
+    old_response = Future()
+    old_response.set_result(SimpleNamespace(success=True, message=json.dumps(snapshot)))
+    updates.pending = old_response
+    updates.sent_at = 0.
+    new_response = Future()
