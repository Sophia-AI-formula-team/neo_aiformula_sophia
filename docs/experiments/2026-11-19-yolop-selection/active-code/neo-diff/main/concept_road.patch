+            nearest['last']=t
+            distance=np.linalg.norm(np.asarray(pose[:2])-nearest['start'])
+            nearest['travel']=max(nearest['travel'],float(distance))
+            nearest['position']+= (anchor-nearest['position'])/nearest['frames']
