+def test_silent_or_replayed_stream_still_latches_at_receipt_deadline():
+    g = ready_auto()
+    g.command((1.,0.), 1.06, 1.06, 1.06)
+    g.joy(False, ZERO, 1.49, 1.49, 1.49)
+    g.command((1.,0.), 1.06, 1.565, 1.565)
+    assert g.paused and g.reason == 'auto_timeout'
