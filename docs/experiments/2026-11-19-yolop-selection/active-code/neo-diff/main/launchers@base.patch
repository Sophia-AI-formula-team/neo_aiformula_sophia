+"""Vehicle source wiring for later build; separate from allnodes."""
+from pathlib import Path
+
+from launch import LaunchDescription
+from launch.actions import IncludeLaunchDescription
+from launch.launch_description_sources import PythonLaunchDescriptionSource
+from launch_ros.actions import Node
+import yaml
+
+
+def generate_launch_description():
+    directory = Path(__file__).resolve().parent
+    config = yaml.safe_load((directory.parent / "config/semantic_vehicle_staged.yaml").read_text())
+    argument_names = ["camera_params_file", "camera_frame_id", "expected_frame_id", "camera_name",
+                      "lane_mask_topic", "odom_topic", "shadow_output_topic", "use_sim_time"]
+    arguments = {name: str(config[name]).lower() if isinstance(config[name], bool) else str(config[name])
+                 for name in argument_names}
+    return LaunchDescription([
+        IncludeLaunchDescription(PythonLaunchDescriptionSource(str(directory / "semantic_shadow.launch.py")),
+                                 launch_arguments=arguments.items()),
+        Node(package="semantic_vehicle_wiring", executable="a3_signal_capture",
+             name="a3_signal_capture", namespace="/semantic_drive", output="screen",
+             parameters=[{"input_topic": config["a3_detections_topic"],
+                          "expected_frame_id": config["expected_frame_id"],
+                          "use_sim_time": config["use_sim_time"]}]),
+    ])
