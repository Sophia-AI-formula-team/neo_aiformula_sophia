new file mode 100644
index 0000000..2310f3a
--- /dev/null
+++ b/vehicle_concept/src/concept_control_gate/concept_control_gate/speed_setting.py
@@ -0,0 +1,48 @@
+"""Keep the two independently owned vehicle speed settings across process starts."""
+import json
+import math
+import os
+from pathlib import Path
+import tempfile
+
+
+class SpeedSetting:
+    def __init__(self, node, name, upper):
+        directory = node.declare_parameter('speed_settings_directory', '').value
+        self.path = Path(directory) / (name + '.json') if directory else None
+        self.name, self.upper = name, upper
+        saved = 4.0
+        load_error = None
+        if self.path is not None:
+            try:
+                saved = json.loads(self.path.read_text(encoding='utf8'))
+                self.validate(saved)
+            except FileNotFoundError:
+                pass
+            except (OSError, ValueError) as exc:
+                # An explicit override can still recover a malformed setting.
+                saved, load_error = None, exc
+        # An explicitly supplied ROS parameter takes priority over the saved default.
+        self.initial = node.declare_parameter(name, saved).value
+        if self.initial is None and load_error is not None:
+            raise ValueError(f'Invalid {self.path}: {load_error}') from load_error
+        self.validate(self.initial)
+
+    def validate(self, value):
+        if type(value) is not float or not math.isfinite(value) or not 0 < value <= self.upper:
+            raise ValueError(f'{self.name} must be a double in (0, {self.upper}] m/s')
+
+    def save(self, value):
+        self.validate(value)
+        if self.path is None:
+            return
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        with tempfile.NamedTemporaryFile(dir=self.path.parent, mode='w', delete=False) as tmp:
+            try:
+                tmp.write(json.dumps(value) + '\n')
+                tmp.flush()
+                os.fsync(tmp.fileno())
+                os.replace(tmp.name, self.path)
+            finally:
+                if os.path.exists(tmp.name):
+                    os.unlink(tmp.name)
diff --git a/vehicle_concept/src/concept_control_gate/test/test_speed_setting.py b/vehicle_concept/src/concept_control_gate/test/test_speed_setting.py
new file mode 100644
index 0000000..63456c0
--- /dev/null
+++ b/vehicle_concept/src/concept_control_gate/test/test_speed_setting.py
@@ -0,0 +1,51 @@
+from types import SimpleNamespace
+
+import pytest
+
+from concept_control_gate.speed_setting import SpeedSetting
+
+
+class Node:
+    def __init__(self, directory='', **overrides):
+        self.params = dict(speed_settings_directory=str(directory), **overrides)
+
+    def declare_parameter(self, name, default):
+        return SimpleNamespace(value=self.params.get(name, default))
+
+
+def test_independent_settings_restart_recovery_and_replay(tmp_path):
+    target, limit = 'target_speed_mps', 'max_auto_speed_mps'
+    driver = SpeedSetting(Node(tmp_path), target, 6.)
+    gate = SpeedSetting(Node(tmp_path), limit, 5.)
+    assert driver.initial == gate.initial == 4.
+    driver.save(2.35)
+    gate.save(1.75)
+    assert SpeedSetting(Node(tmp_path), target, 6.).initial == 2.35
+    assert SpeedSetting(Node(tmp_path), limit, 5.).initial == 1.75
+    with pytest.raises(ValueError):
+        gate.save(float('nan'))
+    assert SpeedSetting(Node(tmp_path), limit, 5.).initial == 1.75
+    gate.path.write_text('{')
+    with pytest.raises(ValueError, match='Invalid'):
+        SpeedSetting(Node(tmp_path), limit, 5.)
+    recovered = SpeedSetting(Node(tmp_path, max_auto_speed_mps=3.), limit, 5.)
+    assert recovered.initial == 3.
+    recovered.save(4.)
+    assert SpeedSetting(Node(tmp_path), limit, 5.).initial == 4.
+    isolated = SpeedSetting(Node(), target, 6.)
+    assert isolated.initial == 4.
+    isolated.save(.5)
+    assert SpeedSetting(Node(tmp_path), target, 6.).initial == 2.35
+
+
+def test_failed_write_keeps_last_setting(tmp_path, monkeypatch):
+    import os
+    setting = SpeedSetting(Node(tmp_path), 'target_speed_mps', 6.)
+    setting.save(2.)
+    def unavailable(source, destination):
+        raise OSError('disk is read only')
+    monkeypatch.setattr(os, 'replace', unavailable)
+    with pytest.raises(OSError, match='read only'):
+        setting.save(4.)
+    assert SpeedSetting(Node(tmp_path), 'target_speed_mps', 6.).initial == 2.
+    assert list(tmp_path.iterdir()) == [setting.path]
