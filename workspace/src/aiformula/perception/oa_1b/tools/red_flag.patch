+    def _on_manual_motion(self, stamp: RosTime) -> None:
+        if self.traffic_mode not in ("prepare", "wait") or self.red_episode_start_ns is None:
+            return
+        started_ns = stamp.sec * 1_000_000_000 + stamp.nanosec
+        age = (self.get_clock().now().nanoseconds - started_ns) * 1e-9
+        if started_ns < self.red_episode_start_ns or not 0.0 <= age <= self.p["cmd_vel_timeout_sec"]:
+            return
+        self._clear_light_confirmation()
+        self.traffic_event_consumed = False
+        self._resume_vision("manual_motion_resume")
+        self.resume_after = time.monotonic()
